# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
APP_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API from a browser.
# Use your website origin in production, e.g. https://site.salvagepulsepro.com
ALLOWED_ORIGINS=*

DATA_DIR=data

# Enables /admin and /api/admin/summary. Use a long random value.
ADMIN_TOKEN=replace-with-a-long-random-token

# ---------------------------------------------------------------------------
# AI provider (OpenAI-compatible Chat Completions + tool calling)
# ---------------------------------------------------------------------------
# Without a key the chatbot still works in guided-script mode: pricing,
# plan cards, demo forms, Stripe checkout, contact forms, and FAQ answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.25
LLM_MAX_TOKENS=900

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Use sk_test_... while testing. The app uses hosted Stripe Checkout with
# subscription price_data, so no dashboard products/prices are required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_ALLOW_PROMOS=true

# ---------------------------------------------------------------------------
# Email (optional but recommended)
# ---------------------------------------------------------------------------
# Demo confirmations and contact messages are stored even when SMTP is absent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Salvage Pulse <sales@salvagepulse.com>

SALES_EMAIL=sales@salvagepulse.com
SUPPORT_EMAIL=support@salvagepulse.com

# ---------------------------------------------------------------------------
# Demo scheduler
# ---------------------------------------------------------------------------
DEMO_TIMEZONE=America/New_York
DEMO_TIMEZONE_LABEL=ET
DEMO_DURATION_MINUTES=45
DEMO_DAYS_AHEAD=21
DEMO_LEAD_TIME_HOURS=18
DEMO_SLOTS=10:00,14:00,16:30
DEMO_MAX_PER_SLOT=1

# Optional: if you would rather send visitors to Calendly or Cal.com, set one
# of these. The built-in scheduler still works underneath.
CALENDLY_URL=
CALCOM_URL=https://cal.com/gen-keech-avipdc/live-demo

# App origin used by account-aware mode to authenticate and read the
# signed-in user's account. No app passwords are stored.
APP_ORIGIN=https://app.salvagepulsepro.com
ACCOUNT_SESSION_MINUTES=30
ACCOUNT_LOGIN_MAX=10
ACCOUNT_LOGIN_WINDOW_MS=300000
